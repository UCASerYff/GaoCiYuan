+// Numeric-only event boundary for GaoQiNianSan. Raw copies are included so the
+// caller can reconcile old aggregate rows using verified source coverage.
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct GQUsageRecord {
+    pub event_id: String, pub client: String, pub session_id: String,
+    pub model: String, pub timestamp: i64, pub input: i64, pub output: i64,
+    pub cache_read: i64, pub cache_write: i64, pub message_count: i32,
+    pub cost: f64, pub duration_ms: i64, pub workspace_path: Option<String>,
+}
+fn gq_dedup_kimi(messages: Vec<UnifiedMessage>) -> Vec<UnifiedMessage> {
+    let mut result: Vec<UnifiedMessage> = Vec::new();
+    let mut index: HashMap<String, usize> = HashMap::new();
+    for message in messages {
+        let key = message.dedup_key.as_ref().filter(|k| !k.trim().is_empty())
+            .map(|k| format!("{}\0{}", message.session_id, k));
+        if let Some(key) = key {
+            if let Some(&i) = index.get(&key) {
+                let old = &mut result[i];
+                old.tokens.input = old.tokens.input.max(message.tokens.input);
+                old.tokens.output = old.tokens.output.max(message.tokens.output);
+                old.tokens.cache_read = old.tokens.cache_read.max(message.tokens.cache_read);
+                old.tokens.cache_write = old.tokens.cache_write.max(message.tokens.cache_write);
+                old.cost = old.cost.max(message.cost);
+                continue;
+            }
+            index.insert(key, result.len());
+        }
+        result.push(message);
+    }
+    result
+}
+pub async fn gq_usage_records(options: ReportOptions) -> Result<Vec<GQUsageRecord>, String> {
+    use sha2::{Digest, Sha256};
+    let home = get_home_dir_string(&options.home_dir)?;
+    let clients = options.clients.clone().unwrap_or_default();
+    let scan = scanner::scan_all_clients_with_scanner_settings(&home, &clients,
+        options.use_env_roots, &options.scanner_settings);
+    let pricing = load_pricing_for_local_parse().await;
+    let mut records = Vec::new();
+    for (client, parser) in [
+        (ClientId::Antigravity, sessions::antigravity::parse_antigravity_file as AntigravitySourceParser),
+        (ClientId::AntigravityCli, sessions::antigravity_cli::parse_antigravity_cli_file as AntigravitySourceParser),
+        (ClientId::AntigravityExtension, sessions::antigravity_cli::parse_antigravity_extension_file as AntigravitySourceParser),
+        (ClientId::Kimi, sessions::kimi::parse_kimi_file as AntigravitySourceParser),
+    ] {
+        let mut paths = scan.get(client).clone(); paths.sort();
+        for path in paths {
+            let parser = if client == ClientId::Kimi && sessions::kimi::is_kimi_code_path(&path) {
+                sessions::kimi::parse_kimi_code_file as AntigravitySourceParser
+            } else { parser };
+            let mut lane = parser(&path);
+            if client == ClientId::Kimi {
+                let mut sources = vec![(path.clone(), lane)];
+                sessions::kimi::apply_code_workspaces(&mut sources);
+                lane = sources.pop().unwrap().1;
+            }
+            for (position, mut message) in lane.into_iter().enumerate() {
+                apply_pricing_if_available(&mut message, pricing.as_deref());
+                let is_kimi = client == ClientId::Kimi;
+                let key = message.dedup_key.as_deref().filter(|k| !k.trim().is_empty())
+                    .map(|k| if is_kimi { format!("kimi\0{}\0{}", message.session_id, k) } else {format!("antigravity\0{}", k)})
+                    // Without a provider ID, equal numbers alone never imply a copy.
+                    .unwrap_or_else(|| format!("{}\0{}\0{}\0{}", client.as_str(), path.display(), message.session_id, position));
+                let event_id = format!("{:x}", Sha256::digest(key.as_bytes()));
+                let session_id = if client == ClientId::AntigravityCli || client == ClientId::AntigravityExtension {
+                    format!("{}:{}", client.as_str(), message.session_id)
+                } else { message.session_id.clone() };
+                records.push(GQUsageRecord {event_id, client: if is_kimi {"kimi"} else {"antigravity"}.into(),
+                    session_id, model: message.model_id, timestamp: message.timestamp,
+                    input: message.tokens.input, output: message.tokens.output, cache_read: message.tokens.cache_read,
+                    cache_write: message.tokens.cache_write, message_count: message.message_count,
+                    cost: message.cost, duration_ms: message.duration_ms.unwrap_or(0), workspace_path: message.workspace_key});
+            }
+        }
+    }
+    Ok(records)
+}
